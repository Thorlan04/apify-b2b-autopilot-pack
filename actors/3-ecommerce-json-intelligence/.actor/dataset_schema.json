{
  "actorSpecification": 1,
  "fields": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "store_domain": {
        "type": "string",
        "description": "Store root domain or audited URL"
      },
      "platform_detected": {
        "type": "string",
        "description": "Detected e-commerce platform (Shopify, WooCommerce, Schema.org LD-JSON, Custom)"
      },
      "currency": {
        "type": "string",
        "description": "Catalog pricing currency"
      },
      "total_products_extracted": {
        "type": "integer",
        "description": "Total number of products extracted"
      },
      "catalog_stats": {
        "type": "object",
        "description": "Statistical summary: min_price, max_price, avg_price, discount_rate, in_stock_ratio"
      },
      "products": {
        "type": "array",
        "items": { "type": "object" },
        "description": "Detailed products list with titles, prices, SKUs, inventory, and variants"
      },
      "extracted_at": {
        "type": "string",
        "description": "ISO 8601 extraction timestamp"
      }
    }
  },
  "views": {
    "overview": {
      "title": "E-Commerce Intelligence Overview",
      "transformation": {
        "fields": [
          "store_domain",
          "platform_detected",
          "currency",
          "total_products_extracted",
          "catalog_stats"
        ]
      },
      "display": {
        "component": "table",
        "properties": {
          "store_domain": { "label": "Store" },
          "platform_detected": { "label": "Platform" },
          "currency": { "label": "Currency" },
          "total_products_extracted": { "label": "Products Count" },
          "catalog_stats": { "label": "Catalog Stats" }
        }
      }
    }
  }
}
