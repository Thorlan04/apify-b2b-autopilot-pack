{
  "actorSpecification": 1,
  "fields": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "target": {
        "type": "string",
        "description": "Original input domain or search query"
      },
      "audited_url": {
        "type": "string",
        "description": "Target website URL audited"
      },
      "company_name": {
        "type": "string",
        "description": "Official corporate registration name"
      },
      "siren": {
        "type": "string",
        "description": "Official 9-digit French SIREN identification number"
      },
      "siret": {
        "type": "string",
        "description": "14-digit French SIRET establishment number"
      },
      "vat_number": {
        "type": "string",
        "description": "Calculated intra-community EU VAT number (FR + 2-digit key + SIREN)"
      },
      "naf_code": {
        "type": "string",
        "description": "Primary economic activity NAF/APE code"
      },
      "employee_bracket": {
        "type": "string",
        "description": "Staff head count bracket"
      },
      "address": {
        "type": "string",
        "description": "Registered head office address"
      },
      "legal_representatives": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Corporate officers, directors and legal representatives"
      },
      "gdpr_compliance_score": {
        "type": "integer",
        "description": "GDPR compliance score (0 to 100)"
      },
      "european_accessibility_eaa_score": {
        "type": "integer",
        "description": "European Accessibility Act (EAA) compliance score (0 to 100)"
      },
      "ai_agent_readiness_score": {
        "type": "integer",
        "description": "AI Agent readiness score (0 to 100)"
      },
      "actionable_fixes": {
        "type": "array",
        "items": { "type": "string" },
        "description": "High-value audit fixes and service offerings for agencies"
      },
      "scanned_at": {
        "type": "string",
        "description": "ISO 8601 audit timestamp"
      }
    }
  },
  "views": {
    "overview": {
      "title": "B2B Compliance Overview",
      "transformation": {
        "fields": [
          "target",
          "company_name",
          "siren",
          "vat_number",
          "gdpr_compliance_score",
          "european_accessibility_eaa_score",
          "ai_agent_readiness_score",
          "actionable_fixes"
        ]
      },
      "display": {
        "component": "table",
        "properties": {
          "target": { "label": "Target" },
          "company_name": { "label": "Company" },
          "siren": { "label": "SIREN" },
          "vat_number": { "label": "VAT Number" },
          "gdpr_compliance_score": { "label": "GDPR Score" },
          "european_accessibility_eaa_score": { "label": "EAA Score" },
          "ai_agent_readiness_score": { "label": "AI Readiness" },
          "actionable_fixes": { "label": "Actionable Fixes" }
        }
      }
    }
  }
}
